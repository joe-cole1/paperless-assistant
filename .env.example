# Copy to .env, replace every example value, and restrict the file to the deployment account.
APP_ENV=production
APP_NAME=paperless-assistant
APP_VERSION=0.1.0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
TZ=America/New_York

# Discord application with Message Content intent enabled.
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_GUILD_ID=123456789012345678
DISCORD_QUESTIONS_CHANNEL_ID=123456789012345679
DISCORD_UPLOADS_CHANNEL_ID=123456789012345680
# JSON array of immutable Discord user IDs.
DISCORD_ALLOWED_USER_IDS=[123456789012345681,123456789012345682]
DISCORD_MAX_ATTACHMENTS=10
DISCORD_MAX_ATTACHMENT_BYTES=26214400

# Internal API traffic and separate browser-visible HTTPS links.
PAPERLESS_INTERNAL_URL=http://paperless-webserver:8000
PAPERLESS_PUBLIC_URL=https://paperless.example.invalid
PAPERLESS_TOKEN=replace-with-paperless-api-token
PAPERLESS_API_VERSION=10
PAPERLESS_SOURCE_TAG=Discord
# Enables Office and EML uploads only; Tika/Gotenberg remain part of Paperless.
PAPERLESS_OFFICE_UPLOADS_ENABLED=false

# Synology host path mounted at /data by Compose.
PAPERLESS_ASSISTANT_DATA_PATH=./data
DATA_DIR=/data
INGESTION_MAX_STAGED_BYTES=104857600
DELIVERY_MIN_FREE_BYTES=52428800

PAPERLESS_CONNECT_TIMEOUT_SECONDS=5
PAPERLESS_READ_TIMEOUT_SECONDS=30
PAPERLESS_WRITE_TIMEOUT_SECONDS=30
PAPERLESS_POOL_TIMEOUT_SECONDS=5
PAPERLESS_CHAT_TIMEOUT_SECONDS=120
PAPERLESS_NATIVE_TASK_NOTIFICATION_TIMEOUT_SECONDS=900
PAPERLESS_OFFICE_TASK_NOTIFICATION_TIMEOUT_SECONDS=1800
PAPERLESS_TASK_POLL_INITIAL_SECONDS=1
PAPERLESS_TASK_POLL_MAX_SECONDS=15
PAPERLESS_TASK_RECOVERY_INTERVAL_SECONDS=60
PAPERLESS_TAXONOMY_REFRESH_SECONDS=300

QUESTION_GLOBAL_CONCURRENCY=2
QUESTION_USER_RATE_LIMIT=10
QUESTION_USER_RATE_WINDOW_SECONDS=300
REFERENCE_CONTEXT_TTL_SECONDS=900

CLEANUP_HOUR_LOCAL=3
QUERY_CONVERSATION_RETENTION_HOURS=24
FAILED_MESSAGE_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90
INSTANCE_LEASE_SECONDS=60
