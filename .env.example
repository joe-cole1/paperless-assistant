# Public, non-secret bootstrap configuration. Copy this file to .env for Compose.
APP_ENV=development
APP_NAME=paperless-assistant
APP_VERSION=0.1.0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
MCP_BOOTSTRAP_MODE=true

# Exact Host headers or SDK-supported wildcard-port entries, comma-separated.
# Before production routing, append: paperless-mcp.thecolefam.com
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*

# Origins are validated only when an Origin header is present. CORS is not enabled.
# Before a browser-based production client requires it, explicitly append its HTTPS origin.
MCP_ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1,http://127.0.0.1:*,http://[::1],http://[::1]:*
